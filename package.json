{
  "name": "hyperion-browser",
  "version": "0.2.0",
  "description": "Hyperion V2 - Universal MCP server for real Chrome browser automation with real-time vision, resilient connections, and LLM-native actions. Works with Cursor, Claude Code, OpenCode, Hermes, and any MCP-compatible agent.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "hyperion": "dist/cli.js",
    "hyperion-server": "dist/mcp/llm-server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "server": "ts-node src/mcp/llm-server.ts",
    "facebook:post": "node dist/cli.js run facebook-post",
    "test": "jest --config jest.config.js",
    "test:integration": "jest --config jest.config.js --testMatch '**/tests/integration/**/*.test.ts'",
    "test:unit": "jest --config jest.config.js --testMatch '**/tests/unit/**/*.test.ts'",
    "lint": "eslint src/**/*.ts",
    "guard:verified": "node scripts/ci/guard-verified-actions.js",
    "format": "prettier --write 'src/**/*.ts'",
    "extension:install": "node dist/native-host/install.js",
    "prepare": "husky"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "events": "^3.3.0",
    "jpeg-js": "^0.4.4",
    "pino": "^9.14.0",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "uuid": "^9.0.0",
    "ws": "^8.16.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.56.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix"
    ]
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "browser-automation",
    "chrome",
    "mcp",
    "llm",
    "ai-agent",
    "real-time-vision",
    "web-scraping",
    "anti-detection",
    "cursor",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ericklrm89-jpg/hyperion.git"
  },
  "bugs": {
    "url": "https://github.com/ericklrm89-jpg/hyperion/issues"
  },
  "author": "ericklrm89-jpg",
  "license": "MIT"
}
